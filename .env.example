# Google Gemini API key (recommended for quick local testing and ADK web UI)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative: Vertex AI Mode (if using Google Cloud IAM instead of AI Studio key)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# BigQuery & ADK Configuration
ADK_MODEL=gemini-2.5-flash
BQ_DATASET=a4i_food
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Google-managed MCP server: MCP Toolbox for Databases (googleapis/genai-toolbox).
# 1. Run: gcloud auth application-default login
# 2. Run: ./scripts/run_mcp_toolbox.sh   (fetches the binary + serves BigQuery tools over MCP)
# 3. Uncomment the line below so agent/agent.py loads its tools (execute_sql, get_table_info, ...)
# MCP_TOOLBOX_URL=http://127.0.0.1:5050
BIGQUERY_PROJECT=qwiklabs-gcp-04-300332596f08
