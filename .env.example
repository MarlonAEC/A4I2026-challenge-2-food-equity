# Google Gemini API key (recommended for quick local testing and ADK web UI)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative: Vertex AI Mode (if using Google Cloud IAM instead of AI Studio key)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# BigQuery & ADK Configuration
ADK_MODEL=gemini-2.5-flash
BQ_DATASET=a4i_food
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# MCP_TOOLBOX_URL=http://localhost:5000
